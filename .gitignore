# Python bytecode cache
__pycache__/
*.pyc

# Lock files
*.lock
.claude/scheduled_tasks.lock

# Node sidecar deps (Pi packages). package.json + package-lock.json stay tracked.
node_modules/
**/node_modules/

# Env files — never commit secrets (placeholder .env.example is ok if present)
.env
.env.*
!.env.example

# User card folders — ignore all top-level dirs except project core
# (Any new card folder is automatically protected from accidental git add)
*/
!.claude/
!.claude/commands/
!.claude/commands/**
!.claude/skills/
!.claude/skills/**
!.claude/settings.local.json
# Formal production package. Runtime/user data remains outside the source tree.
!src/
!src/airp/
!src/airp/**
src/airp/**/__pycache__/
src/airp/**/*.pyc
# Runtime projections and Workspace data written beside the static web shell.
src/airp/web/.airp-runtime/
src/airp/web/content.js
src/airp/web/state.js
src/airp/web/studio/
!tests/
!tests/*.py
!tests/browser/
!tests/browser/**
!docs/
!docs/**/
!docs/**/*.md
!package.json
!package-lock.json
!scripts/
!scripts/build_pi_sidecar.mjs
